# Adresse Gmail dédiée à l'agent IA (ex: camping.millau.ia@gmail.com)
GMAIL_ADDRESS=votre.agent@gmail.com

# Mot de passe d'application Gmail (pas votre mot de passe habituel)
# Générez-le sur : myaccount.google.com > Sécurité > Mots de passe des applications
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Clé API Anthropic (Claude)
# Obtenez-la sur : console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Chemin vers le fichier ZIP de sauvegarde Inaxel (mis à jour chaque matin)
ZIP_BACKUP_PATH=data/backups/inaxel_backup.zip

# Email du gérant pour le rapport hebdomadaire
EMAIL_GERANT=gerant@campingsaintlambert.fr
