# Clé API OpenAI (optionnel — mode mock si absent)
OPENAI_API_KEY=sk-...

# Modèle OpenAI utilisé
OPENAI_MODEL=gpt-4o

# Nom de votre entreprise (affiché dans l'interface)
COMPANY_NAME=Camping Saint Lambert & Vanéa

# Style de réponse souhaité (professionnel, concis, détaillé)
RESPONSE_STYLE=professionnel

# Chemin vers la base de données SQLite
DATABASE_URL=sqlite:///./data/platform.db
